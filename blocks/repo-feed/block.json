{
  "apiVersion": 2,
  "name": "wpgit/repo-feed",
  "title": "GitHub repository feed",
  "category": "widgets",
  "icon": "update",
  "description": "Display commits or activity from a GitHub repository.",
  "keywords": ["github", "commits", "feed", "repository"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "sourceType": {
      "type": "string",
      "default": "url"
    },
    "repoUrl": {
      "type": "string",
      "default": ""
    },
    "acfField": {
      "type": "string",
      "default": ""
    },
    "feedType": {
      "type": "string",
      "default": "commits"
    },
    "limit": {
      "type": "number",
      "default": 10
    },
    "width": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "wp-git-tickets",
  "editorScript": "wpgit-blocks-editor",
  "style": "wpgit-blocks"
}
