{
  "apiVersion": 2,
  "name": "wpgit/org-feed",
  "title": "GitHub organization feed",
  "category": "widgets",
  "icon": "groups",
  "description": "Display commits or activity across a GitHub organization.",
  "keywords": ["github", "organization", "commits", "feed"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "org": {
      "type": "string",
      "default": ""
    },
    "feedType": {
      "type": "string",
      "default": "events"
    },
    "limit": {
      "type": "number",
      "default": 10
    },
    "width": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "wp-git-tickets",
  "editorScript": "wpgit-blocks-editor",
  "style": "wpgit-blocks"
}
